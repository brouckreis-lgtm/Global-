@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700&display=swap');

:root {
  --black: #050505;
  --gold: #D4AF37;
  --bronze: #E2B37E;
  --glass: rgba(255, 255, 255, 0.03);
  --border: rgba(255, 255, 255, 0.1);
}

body {
  background-color: var(--black);
  color: #e5e7eb;
  font-family: 'Inter', sans-serif;
  overflow-x: hidden;
}

/* Effet de texte dégradé Or */
.gold-gradient {
  background: linear-gradient(to right, var(--bronze), var(--gold), var(--bronze));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* Panneau de verre givré (Glassmorphism) */
.glass-panel {
  background: var(--glass);
  backdrop-filter: blur(12px);
  border: 1px solid var(--border);
  border-radius: 24px;
}

/* Curseur magnétique (logique JS à ajouter) */
.cursor-gold {
  width: 20px;
  height: 20px;
  background: var(--gold);
  border-radius: 50%;
  position: fixed;
  pointer-events: none;
  filter: blur(8px);
  z-index: 9999;
}
